# NOVARA v2 — copy to .env.local and replace placeholders for the target environment.
NEXT_PUBLIC_SITE_URL=https://nnovara.io

# ── Payments ────────────────────────────────────────────────
# (unset) → online card payment is DISABLED. Checkout offers bank transfer and
#           quotation requests instead — it never shows a card form that does
#           nothing. Keep this empty until a reviewed provider implementation exists.
PAYMENT_PROVIDER=
ENABLE_BANK_TRANSFER=true
TAX_RATE=0                   # decimal, e.g. 0.16 for 16% — applied server-side only

# Add provider-specific server-only variable names only after receiving and reviewing
# the official Capital Bank/provider integration documentation. Never prefix secrets
# with NEXT_PUBLIC_. Webhooks use /api/payments/webhook/<provider>.
# An order is marked paid ONLY from a verified webhook — never a browser redirect.

# ── Database, accounts and order access ──
AUTH_SECRET=                 # openssl rand -base64 32
ORDER_ACCESS_SECRET=         # openssl rand -base64 32; signs guest order-status links
DATABASE_URL=postgresql://user:password@host:5432/novara
DIRECT_URL=postgresql://user:password@host:5432/novara

# ── Email (contact form, order confirmations) ──
SMTP_URL=
MAIL_FROM=hello@nnovara.io
CONTACT_TO_EMAIL=hello@nnovara.io

# Comma-separated HTTPS origins supplied by a future hosted payment provider.
# Leave empty until the provider documentation identifies the exact required origins.
CSP_PAYMENT_ORIGINS=

# ── Admin dashboard (§34) ───────────────────────────────────
# PostgreSQL is required for accounts, checkout, contact retention and the admin area.

# First-run super admin — used once by `npm run admin:setup`, then rotate.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=      # min 12 chars; you'll be forced to change it on first login
ADMIN_INITIAL_NAME=Super Admin

# Media storage (§8) — local in dev; set a provider for production.
MEDIA_PROVIDER=local         # local | s3 | r2 | cloudinary | vercel_blob
# S3_BUCKET= S3_REGION= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID= R2_BUCKET= R2_ACCESS_KEY_ID= R2_SECRET_ACCESS_KEY=
# CLOUDINARY_URL=
# BLOB_READ_WRITE_TOKEN=
